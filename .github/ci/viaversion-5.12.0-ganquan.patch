@@ -0,0 +1,52 @@
+/*
+ * Compatibility shim for EaseCation ViaBedrock custom mapping overlays.
+ * The official ViaVersion pipeline does not consume these entries; ViaBedrock
+ * still stores them so login and mapping install do not crash.
+ */
+package com.viaversion.viaversion.api.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public final class CustomRegistryStorage implements StorableObject {
+
+    public static final int BLOCK_STATE = 0;
+    public static final int BLOCK_ENTITY_TYPE = 1;
+    public static final int ITEM = 2;
+
+    private final Map<OverlayKey, OverlayEntry> overlays = new HashMap<>();
+    private final Map<RangeKey, int[]> sourceRanges = new HashMap<>();
+
+    public void putSourceRange(final Class<?> protocolClass, final int type, final int minSourceId, final int maxSourceId) {
+        this.sourceRanges.put(new RangeKey(protocolClass, type), new int[]{minSourceId, maxSourceId});
+    }
+
+    public void put(final Class<?> protocolClass, final int type, final int sourceId, final int targetId, final String name) {
+        this.overlays.put(new OverlayKey(protocolClass, type, sourceId), new OverlayEntry(targetId, name));
+    }
+
+    public Integer remap(final Class<?> protocolClass, final int type, final int sourceId) {
+        final OverlayEntry entry = this.overlays.get(new OverlayKey(protocolClass, type, sourceId));
+        return entry != null ? entry.targetId() : null;
+    }
+
+    public int[] sourceRange(final Class<?> protocolClass, final int type) {
+        return this.sourceRanges.get(new RangeKey(protocolClass, type));
+    }
+
+    public void clear() {
+        this.overlays.clear();
+        this.sourceRanges.clear();
+    }
+
+    private record OverlayKey(Class<?> protocolClass, int type, int sourceId) {
+    }
+
+    private record RangeKey(Class<?> protocolClass, int type) {
+    }
+
+    private record OverlayEntry(int targetId, String name) {
+    }
+}
