+/*
+ * Compatibility shim for EaseCation ViaBedrock.
+ * Official ViaVersion does not ship this hook; ViaBedrock JoinGate stores one
+ * on the UserConnection and expects PacketWrapper.send() to consult it.
+ */
+package com.viaversion.viaversion.api.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.exception.InformativeException;
+
+public final class PacketSendInterceptor extends StoredObject {
+
+    @FunctionalInterface
+    public interface Handler {
+        /**
+         * @return true if the packet was consumed and must not be sent
+         */
+        boolean intercept(PacketWrapper wrapper) throws InformativeException;
+    }
+
+    private final Handler handler;
+
+    public PacketSendInterceptor(final UserConnection user, final Handler handler) {
+        super(user);
+        this.handler = handler;
+    }
+
+    public boolean intercept(final PacketWrapper wrapper) throws InformativeException {
+        return this.handler != null && this.handler.intercept(wrapper);
+    }
+}
